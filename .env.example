# Copy to .env.local and fill in your Sanity project values.
# Create a project at https://www.sanity.io/manage

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-02

# Server-only secrets for quiz submissions (POST /api/quiz). Do NOT prefix with
# NEXT_PUBLIC — these must stay server-side.
# Sanity token with write access (create at https://www.sanity.io/manage).
SANITY_API_WRITE_TOKEN=
# Resend email notification of new quiz leads (https://resend.com).
RESEND_API_KEY=
QUIZ_NOTIFICATION_TO=
QUIZ_NOTIFICATION_FROM=
